# 買取店マーケティングシステム 環境変数サンプル
# このファイルを .env にコピーして値を入れてください（.env はコミットしない）

# サーバー
PORT=5300
PUBLIC_BASE_URL=http://localhost:5300

# Claude（記事生成）。※本番Renderには ANTHROPIC_BASE_URL を入れないこと。
# ローカルでComputer実行環境からテストする時は  env -u ANTHROPIC_BASE_URL node ...  で剥がす。
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# 画像生成（任意・MVPでは未使用でも可）
OPENAI_API_KEY=
